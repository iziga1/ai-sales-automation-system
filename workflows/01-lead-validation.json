      "id": "d618e2fa-38a4-410e-b079-04eeb3884b08",
      "name": "Get row(s) in sheet"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nconst requiredFields = [\n  \"company_name\",\n  \"contact_name\",\n  \"email\",\n  \"country\",\n];\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nfunction normalizeText(value) {\n  return String(value ?? \"\").trim();\n}\n\nfunction normalizeEmail(value) {\n  return normalizeText(value).toLowerCase();\n}\n\nconst seenEmails = new Map();\nconst seenIds = new Set();\n\nconst results = items.map((item) => {\n  const original = item.json;\n\n  const lead = {\n    ...original,\n    lead_id: normalizeText(original.lead_id),\n    company_name: normalizeText(original.company_name),\n    contact_name: normalizeText(original.contact_name),\n    email: normalizeEmail(original.email),\n    phone: normalizeText(original.phone),\n    country: normalizeText(original.country),\n    industry: normalizeText(original.industry),\n    status: normalizeText(original.status),\n  };\n\n  const errors = [];\n\n  if (!lead.lead_id) {\n    errors.push(\"Missing lead_id\");\n  }\n\n  for (const field of requiredFields) {\n    if (!lead[field]) {\n      errors.push(`Missing required field: ${field}`);\n    }\n  }\n\n  if (lead.email && !emailRegex.test(lead.email)) {\n    errors.push(\"Invalid email format\");\n  }\n\n  if (seenIds.has(lead.lead_id)) {\n    errors.push(\"Duplicate lead_id\");\n  }\n\n  if (lead.lead_id) {\n    seenIds.add(lead.lead_id);\n  }\n\n  let validationResult = \"valid\";\n  let duplicateOf = \"\";\n\n  if (errors.length > 0) {\n    validationResult = \"invalid\";\n  } else if (seenEmails.has(lead.email)) {\n    validationResult = \"duplicate\";\n    duplicateOf = seenEmails.get(lead.email);\n  } else {\n    seenEmails.set(lead.email, lead.lead_id);\n  }\n\n  return {\n    json: {\n      ...lead,\n      validation_result: validationResult,\n      duplicate_of: duplicateOf,\n      validation_errors: errors.join(\"; \"),\n      processed_at: new Date().toISOString(),\n    },\n  };\n});\n\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
