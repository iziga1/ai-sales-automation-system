      ],
      "id": "node-error-trigger",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "\nconst input = $input.first().json;\n\nconst workflow = input.workflow ?? {};\nconst execution = input.execution ?? {};\nconst trigger = input.trigger ?? {};\n\nconst error = execution.error ?? trigger.error ?? {};\n\nconst errorMessage =\n  error.message ??\n  error.description ??\n  \"Unknown workflow error\";\n\nconst errorNode =\n  execution.lastNodeExecuted ??\n  error.node?.name ??\n  \"Unknown\";\n\nconst timestamp = new Date().toISOString();\n\nconst errorId = `ERR-${Date.now()}-${Math.random()\n  .toString(36)\n  .slice(2, 8)}`;\n\nreturn [\n  {\n    json: {\n      error_id: errorId,\n      workflow_name: workflow.name ?? \"Unknown\",\n      workflow_id: workflow.id ?? \"\",\n      execution_id: execution.id ?? \"\",\n      error_message: String(errorMessage),\n      error_node: String(errorNode),\n      timestamp,\n      status: \"new\"\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "node-format-error-log",
      "name": "Format Error Log"
    },
