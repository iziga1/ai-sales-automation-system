      "name": "Read Follow-Up Drafts",
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "\nconst leads = $(\"Read Leads\").all().map(item => item.json);\nconst calls = $(\"Read Call Analysis\").all().map(item => item.json);\nconst drafts = $(\"Read Follow-Up Drafts\").all().map(item => item.json);\n\n// Calculate the average score from analyzed calls.\nconst scores = calls\n  .map(call => Number(call.lead_score))\n  .filter(score => Number.isFinite(score) && score >= 0 && score <= 100);\n\nconst averageLeadScore = scores.length > 0\n  ? Math.round(\n      (scores.reduce((sum, score) => sum + score, 0) / scores.length) * 10\n    ) / 10\n  : null;\n\n// Count saved email drafts.\nconst draftCount = drafts.filter(\n  draft => String(draft.draft_status ?? \"\").toLowerCase() === \"draft\"\n).length;\n\nreturn [\n  {\n    json: {\n      total_leads: leads.length,\n      calls_analyzed: calls.length,\n      average_lead_score: averageLeadScore,\n      follow_up_drafts: draftCount,\n      last_updated: new Date().toISOString()\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
